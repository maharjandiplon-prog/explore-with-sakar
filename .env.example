# ============================================================
# EXPLORE WITH SAKAR — Environment Variables
# Copy this file to .env.local for local development.
# Set all REQUIRED variables in production settings.
# ============================================================

# ── Primary Database Selection ────────────────────────────────
# Controls which backend is used: 'firebase' | 'file'
# If unset, defaults to 'firebase' if Firebase variables are present,
# otherwise falls back to 'file' (local seed) in offline dev.
CMS_STORAGE=firebase

# ── Firebase (Cloud Firestore & Cloud Storage) ───────────────
# Generated from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Note: Keep newlines formatted as \n or raw multi-line string:
FIREBASE_PRIVATE_KEY=
# Storage bucket name (e.g. explore-with-sakar.appspot.com)
FIREBASE_STORAGE_BUCKET=

# ── Admin Authentication (REQUIRED in production) ────────────
# A long random string used to sign admin JWT session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
ADMIN_JWT_SECRET=

# Initial admin credentials (used on first boot to seed the admin user)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── Bootstrap / Sync (OPTIONAL) ──────────────────────────────
# Secret used to call /api/admin/sync-seed and /api/admin/debug-db via
# x-sync-secret header when needed.
SYNC_SECRET=

# ── Google Search Console Performance Analytics ─────────────
# OAuth 2.0 Web Application credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SEARCH_CONSOLE_PROPERTY=sc-domain:explorewithsakar.com
GOOGLE_REDIRECT_URI=
